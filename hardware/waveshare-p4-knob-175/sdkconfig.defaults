# Waveshare ESP32-P4-Knob-Touch-AMOLED-1.75 (ESP32-P4NRW32X, silicon v3.x).
# After editing, delete .pio/sdkconfig.waveshare_p4_knob: an existing sdkconfig
# is not refreshed from these defaults.
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="hardware/waveshare-p4-knob-175/partitions.csv"
# The QIO bootloader at INFO level does not fit the 0x6000 bytes before 0x8000.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# Run code and constants from PSRAM so flash writes (NVS, LittleFS) never stall
# the CPU while the display streams from PSRAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CORETIMER_SYSTIMER_LVL3=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
CONFIG_ARDUINO_VARIANT="esp32p4"
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_MAX_SOCKETS=16

# Waveshare loads its ESP32 radio runtime over SDIO each time the P4 starts.
CONFIG_ESP_HOST_WIFI_ENABLED=y
CONFIG_ESP_WIFI_CONTROLLER_TARGET="esp32"
# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
CONFIG_ESP_EXT_CONN_ENABLE=y
CONFIG_ESP_EXT_CONN_WIFI_ENABLE=y
CONFIG_ESP_EXT_CONN_BT_ENABLE=y
CONFIG_ESP_EXT_CONN_VIA_SDIO=y
CONFIG_ESP_EXT_CONN_SLAVE_ENABLE_PIN=54
CONFIG_ESP_EXT_CONN_SLAVE_ENABLE_LVL=1
CONFIG_ESP_EXT_CONN_SLAVE_BOOT_PIN=6
CONFIG_ESP_EXT_CONN_SDIO_SLOT=1
CONFIG_ESP_EXT_CONN_SDIO_CLK_PIN=18
CONFIG_ESP_EXT_CONN_SDIO_CMD_PIN=19
CONFIG_ESP_EXT_CONN_SDIO_D0_PIN=14
CONFIG_ESP_EXT_CONN_SDIO_D1_PIN=15
CONFIG_ESP_EXT_CONN_SDIO_D2_PIN=16
CONFIG_ESP_EXT_CONN_SDIO_D3_PIN=17
CONFIG_ESP_EXT_CONN_RECV_TASK_STACK=4096
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_CONNECT_RETRY_COUNT=0
CONFIG_BT_BLE_ESTAB_LINK_CONN_TOUT=8
CONFIG_BT_GATTC_CACHE_NVS_FLASH=n
CONFIG_BT_GATTC_MAX_CACHE_CHAR=96
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=n
CONFIG_BT_BLE_42_SCAN_EN=y
CONFIG_BT_CONTROLLER_DISABLED=y

# USB serial console on the P4's USB-OTG port (TinyUSB CDC), see arduino_tinyusb.
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
# USB drive mode (usb_drive.cpp): the TF card as a mass storage interface next
# to the console. 4096 is the prebuilt library's own MSC buffer size.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# Card storage as on the other boards: long file names (Dragon's folders are
# "recordings", "resources" and longer), UTF-8 names, code page 850. Without
# LFN the card mounts but Dragon cannot create its folders and turns it off.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_850=y
# Task stacks the shared code was sized for (the S3 boards' Arduino libraries).
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3120
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_ISR_STACKSIZE=2096
